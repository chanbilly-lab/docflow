{
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "caseId": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "const": "USER"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^t_c_[A-Za-z0-9_-]+_[1-9][0-9]*$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "reviewerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "taskId",
        "attempt",
        "reviewerId",
        "startedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "caseId",
    "actor",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewStarted detail v1.0",
  "description": "An assigned reviewer started the current review; no comments or callback data."
}
