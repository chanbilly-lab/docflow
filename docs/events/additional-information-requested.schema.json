{
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "caseId": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "const": "SYSTEM"
        },
        "id": {
          "const": "workflow-finalize-case"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^t_c_[A-Za-z0-9_-]+_[1-9][0-9]*$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "reviewerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "decision": {
          "const": "REQUEST_INFORMATION"
        },
        "decisionReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "requestedItems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "documentType": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              "reasonCode": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              }
            },
            "required": [
              "documentType",
              "reasonCode",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "taskId",
        "attempt",
        "reviewerId",
        "decision",
        "decisionReason",
        "requestedItems"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "caseId",
    "actor",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdditionalInformationRequested detail v1.0",
  "description": "Finalized persisted review decision; excludes tokens and private callback metadata."
}
